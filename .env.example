# LocalFin AI environment template
# Copy this file to .env and fill in real secrets before starting the app.

# Optional: OPENROUTER_API_KEY no longer used by server. External agents bring their own LLM keys.
# OPENROUTER_API_KEY=

# Optional local server/client overrides.
# CORS_ORIGIN accepts a comma-separated list.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
# LOCALFIN_DATA_DIR=data
# LOCALFIN_DB_PATH=data/budget.db

# Required before linking provider accounts. Generate once, keep stable.
LOCALFIN_PROVIDER_SECRET=replace_with_at_least_32_random_characters

# Plaid provider linking.
PLAID_CLIENT_ID=replace_with_plaid_client_id
PLAID_SECRET=replace_with_plaid_sandbox_or_live_secret
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=http://localhost:5173/setup

# Akoya provider linking.
AKOYA_CLIENT_ID=replace_with_akoya_client_id
AKOYA_CLIENT_SECRET=replace_with_akoya_client_secret
AKOYA_AUTH_BASE_URL=https://sandbox-idp.ddp.akoya.com
AKOYA_API_BASE_URL=https://sandbox-products.ddp.akoya.com
AKOYA_REDIRECT_URI=http://localhost:3001/api/account-linking/akoya/callback
AKOYA_CONNECTOR=mikomo
AKOYA_PROVIDER_ID=mikomo
AKOYA_API_VERSION=v3

# Live agent evaluation only. Leave commented unless intentionally running
# `npm run eval:agent:live`; this makes real OpenRouter calls.
#
# Enables the live eval script. The script exits unless this is set to 1.
# RUN_LIVE_AGENT_EVAL=1
#
# Runs only the first N live eval scenarios; useful for a quick smoke run.
# AGENT_EVAL_LIMIT=1
#
# Keeps each temporary live eval SQLite database for inspection after the run.
# AGENT_EVAL_KEEP_DBS=1
