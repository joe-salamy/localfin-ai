{
  "name": "ai-budget-app-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:archive": "tsx scripts/start-archive-dev.ts",
    "test": "npm run test:server && npm run test:scripts",
    "test:server": "node --import tsx --test \"server/**/*.test.ts\"",
    "test:scripts": "node --import tsx --test \"scripts/**/*.test.ts\"",
    "report:dashboard": "tsx scripts/render-dashboard-html.ts",
    "report:history": "tsx scripts/render-history-html.ts",
    "categorize:export": "tsx scripts/export-categorize-ods.ts",
    "categorize:apply": "tsx scripts/apply-categorize-ods.ts",
    "categorize:prepare": "tsx scripts/categorize-judge.ts prepare",
    "categorize:apply-judgments": "tsx scripts/categorize-judge.ts apply",
    "taxonomy:export": "tsx scripts/export-taxonomy-ods.ts",
    "taxonomy:apply": "tsx scripts/apply-taxonomy-ods.ts",
    "ingest:csv": "tsx scripts/ingest-statement-csv.ts",
    "ingest:downloads": "tsx scripts/ingest-downloads.ts",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b",
    "lint": "eslint .",
    "mcp": "node --import tsx server/mcp/index.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node --import tsx server/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "express": "^5.2.1",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "typescript-language-server": "^5.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0 <26"
  }
}
